# =============================================================================
# kvm-lab — Configurazione centralizzata
# Copia questo file in lab.env (lo fa make setup) e adattalo: lab.env NON e' versionato
# perche' contiene la password delle VM. Rigenera VM_PASS_HASH con:
#   openssl passwd -6 "<password>"
# =============================================================================

VM_USER=labuser
VM_PASS=changeme
# Hash generato con: openssl passwd -6 "${VM_PASS}"
VM_PASS_HASH='$6$ZtLpAeQ/GEmR2bDF$4026VAuHyCxxJj3OXj4p9W39y1GfdJwvRQT8vJo7m3X4MOf5tSPX7xQqL8BT1PZsavj9PgyCmMOFQvKiuypRM/'
VM_REALNAME="Lab User"
VM_BASE_DIR=$HOME/Workspaces/qemu

# Anche le appliance di rete usano VM_USER/VM_PASS (Linux, utente pfSense e Web Pi-hole).
# pfSense conserva anche l'account integrato admin, con la stessa VM_PASS.
# ISO offline supportata dall'installer ZFS unattended (opzionale):
# export PFSENSE_ISO="$VM_BASE_DIR/storage/Iso/Distro/pfSense-CE-2.7.2-RELEASE-amd64.iso"

render_template() {
    local src="$1" dst="$2"
    sed \
        -e "s|__VM_USER__|${VM_USER}|g" \
        -e "s|__VM_PASS__|${VM_PASS}|g" \
        -e "s|__VM_PASS_HASH__|${VM_PASS_HASH}|g" \
        -e "s|__VM_REALNAME__|${VM_REALNAME}|g" \
        -e "s|__VM_BASE_DIR__|${VM_BASE_DIR}|g" \
        "$src" > "$dst"
}
