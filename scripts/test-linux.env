# Configurazione del test end-to-end Linux (scripts/test-linux.sh)
# Sovrascrivibile da variabili d'ambiente: es. TEST_PARALLEL=6 bash scripts/test-linux.sh

# Quante VM testare in parallelo (ogni VM usa ~4 GB di RAM durante l'install)
TEST_PARALLEL="${TEST_PARALLEL:-4}"

# Cartella output (report HTML + log + screenshot). Override: TEST_OUTDIR=/path.
TEST_OUTDIR="${TEST_OUTDIR:-${TMPDIR:-/tmp}/vmlab-e2e}"

# Apri il report HTML nel browser all'avvio (1=si, 0=no, utile headless)
TEST_OPEN_BROWSER="${TEST_OPEN_BROWSER:-1}"

# Timeout (secondi)
TEST_BASE_TIMEOUT="${TEST_BASE_TIMEOUT:-3000}"      # autoinstall base -> shut off (~50 min)
TEST_DESKTOP_TIMEOUT="${TEST_DESKTOP_TIMEOUT:-3600}" # boot + desktop pronto (~60 min, firstboot 26 e' lento)
TEST_SHUTDOWN_TIMEOUT="${TEST_SHUTDOWN_TIMEOUT:-180}" # spegnimento VM dopo verifica/screenshot
TEST_POLL="${TEST_POLL:-20}"                         # intervallo polling

# -----------------------------------------------------------------------------
# VM da testare: derivate dal registro vms.tsv (family=linux, e2e=yes), che e'
# l'unica fonte di verita' dell'inventario. Per aggiungere/togliere una VM dai
# test si modifica la colonna e2e nel registro, non questo file.
#
# Contratto Linux: script -> VM shut off -> virsh start -> qemu-guest-agent ->
# verifica desktop. Formato item: "id|vm|script".
#
# Per testare un sottoinsieme senza toccare il registro, copia questo file,
# sostituisci i due mapfile con array espliciti e passa TEST_ENV_FILE=/path.
# -----------------------------------------------------------------------------
_VMLAB_ENV_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

mapfile -t TEST_ITEMS < <(bash "$_VMLAB_ENV_DIR/vms-registry.sh" --items linux)
mapfile -t TEST_EXCLUDED_ITEMS < <(bash "$_VMLAB_ENV_DIR/vms-registry.sh" --excluded linux)

if [ "${#TEST_ITEMS[@]}" -eq 0 ]; then
    echo "ATTENZIONE: nessuna VM Linux con e2e=yes nel registro vms.tsv" >&2
fi
