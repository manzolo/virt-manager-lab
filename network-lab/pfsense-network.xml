<?xml version='1.0' encoding='utf-8'?>
<pfsense>
  <interfaces>
    <wan>
      <enable />
      <if>vtnet0</if>
      <ipaddr>dhcp</ipaddr>
      <ipaddrv6>dhcp6</ipaddrv6>
      <gateway />
      <blockpriv>on</blockpriv>
      <blockbogons>on</blockbogons>
      <media />
      <mediaopt />
      <dhcp6-duid />
      <dhcp6-ia-pd-len>0</dhcp6-ia-pd-len>
    </wan>
    <lan>
      <enable />
      <if>vtnet1</if>
      <ipaddr>192.168.0.1</ipaddr>
      <subnet>24</subnet>
      <ipaddrv6 />
      <subnetv6 />
      <media />
      <mediaopt />
      <track6-interface>wan</track6-interface>
      <track6-prefix-id>0</track6-prefix-id>
      <gateway />
      <gatewayv6 />
    </lan>
  </interfaces>
  <dhcpd>
    <lan>
      <range>
        <from>192.168.0.10</from>
        <to>192.168.0.245</to>
      </range>
    </lan>
  </dhcpd>
  <dhcpdv6>
    <lan>
      <range>
        <from>::1000</from>
        <to>::2000</to>
      </range>
      <ramode>disabled</ramode>
      <rapriority>medium</rapriority>
    </lan>
  </dhcpdv6>
  <unbound>
    <enable />
    <dnssec />
    <active_interface />
    <outgoing_interface />
    <custom_options />
    <hideidentity />
    <hideversion />
    <dnssecstripped />
  </unbound>
  <dnsmasq />
  <nat>
    <outbound>
      <mode>automatic</mode>
    </outbound>
  </nat>
  <filter>
    <rule>
      <id />
      <tracker>1709572180</tracker>
      <type>block</type>
      <interface>lan</interface>
      <ipprotocol>inet</ipprotocol>
      <tag />
      <tagged />
      <max />
      <max-src-nodes />
      <max-src-conn />
      <max-src-states />
      <statetimeout />
      <statetype>keep state</statetype>
      <os />
      <protocol>tcp</protocol>
      <source>
        <any />
      </source>
      <destination>
        <address>192.168.1.50</address>
        <port>22</port>
      </destination>
      <descr />
    </rule>
    <rule>
      <id />
      <tracker>1709905985</tracker>
      <type>block</type>
      <interface>lan</interface>
      <ipprotocol>inet</ipprotocol>
      <tag />
      <tagged />
      <max />
      <max-src-nodes />
      <max-src-conn />
      <max-src-states />
      <statetimeout />
      <statetype>keep state</statetype>
      <os />
      <protocol>tcp</protocol>
      <source>
        <address>192.168.0.220</address>
      </source>
      <destination>
        <any />
      </destination>
      <descr>Test block al connection for ip</descr>
      <disabled />
    </rule>
    <rule>
      <type>pass</type>
      <ipprotocol>inet</ipprotocol>
      <descr>Default allow LAN to any rule</descr>
      <interface>lan</interface>
      <tracker>0100000101</tracker>
      <source>
        <network>lan</network>
      </source>
      <destination>
        <any />
      </destination>
    </rule>
    <rule>
      <type>pass</type>
      <ipprotocol>inet6</ipprotocol>
      <descr>Default allow LAN IPv6 to any rule</descr>
      <interface>lan</interface>
      <tracker>0100000102</tracker>
      <source>
        <network>lan</network>
      </source>
      <destination>
        <any />
      </destination>
    </rule>
    <separator>
      <lan />
    </separator>
  </filter>
  <aliases />
  <staticroutes>
	</staticroutes>
  <gateways>
	</gateways>
  <vlans />
  <system>
    <hostname>firewall</hostname>
    <domain>qlan</domain>
    <dnsserver>192.168.0.10</dnsserver>
    <disablesegmentationoffloading />
    <disablelargereceiveoffloading />
  </system>
</pfsense>