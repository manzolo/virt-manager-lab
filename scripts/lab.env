# =============================================================================
# Lab QEMU/virt-manager — Configurazione centralizzata
# Modifica questo file per adattare il lab al tuo sistema.
# =============================================================================

VM_USER=manzolo
VM_PASS=manzolo
# Hash generato con: openssl passwd -6 "${VM_PASS}"
VM_PASS_HASH='$6$xAz1OOYvRK3.5IdZ$sgTB7qeJUZ7QG62n2AGN146CRBfwwAeWMYHdLZk/sZYSvWub.APwbCwMfSnbteh7/78mWFWzHFoxEZgwV/T/H/'
VM_REALNAME=Manzolo
VM_BASE_DIR=/home/manzolo/Workspaces/qemu

render_template() {
    local src="$1" dst="$2"
    sed \
        -e "s|__VM_USER__|${VM_USER}|g" \
        -e "s|__VM_PASS__|${VM_PASS}|g" \
        -e "s|__VM_PASS_HASH__|${VM_PASS_HASH}|g" \
        -e "s|__VM_REALNAME__|${VM_REALNAME}|g" \
        -e "s|__VM_BASE_DIR__|${VM_BASE_DIR}|g" \
        "$src" > "$dst"
}
