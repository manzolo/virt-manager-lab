# Configurazione del test end-to-end (scripts/test-all.sh)
# Sovrascrivibile da variabili d'ambiente: es. TEST_PARALLEL=6 bash scripts/test-all.sh

# Quante VM testare in parallelo (ogni VM usa ~4 GB di RAM durante l'install)
TEST_PARALLEL="${TEST_PARALLEL:-4}"

# Cartella output (report HTML + log + screenshot). Override: TEST_OUTDIR=/path.
TEST_OUTDIR="${TEST_OUTDIR:-${TMPDIR:-/tmp}/vmlab-e2e}"

# Apri il report HTML nel browser all'avvio (1=si, 0=no, utile headless)
TEST_OPEN_BROWSER="${TEST_OPEN_BROWSER:-1}"

# Timeout (secondi)
TEST_BASE_TIMEOUT="${TEST_BASE_TIMEOUT:-3000}"      # autoinstall base -> shut off (~50 min)
TEST_DESKTOP_TIMEOUT="${TEST_DESKTOP_TIMEOUT:-3600}" # boot + desktop pronto (~60 min, firstboot 26 e' lento)
TEST_SHUTDOWN_TIMEOUT="${TEST_SHUTDOWN_TIMEOUT:-180}" # spegnimento VM dopo verifica/screenshot
TEST_POLL="${TEST_POLL:-20}"                         # intervallo polling

# VM da testare end-to-end con contratto Linux autoinstall:
# script -> VM shut off -> virsh start -> qemu-guest-agent Linux -> verifica desktop.
# (id = ID Makefile; aggiungi/togli righe per scegliere cosa testare)
TEST_ITEMS=(
  "kubuntu22|kubuntu22.04|scripts/install-kubuntu22.04.sh"
  "xubuntu22|xubuntu22.04|scripts/install-xubuntu22.04.sh"
  "mate22|ubuntu-mate22.04|scripts/install-mate22.04.sh"
  "budgie22|ubuntu-budgie22.04|scripts/install-budgie22.04.sh"
  "kubuntu24|kubuntu24.04|scripts/install-kubuntu24.04.sh"
  "xubuntu24|xubuntu24.04|scripts/install-xubuntu24.04.sh"
  "mate24|ubuntu-mate24.04|scripts/install-mate24.04.sh"
  "budgie24|ubuntu-budgie24.04|scripts/install-budgie24.04.sh"
  "kubuntu26|kubuntu26.04|scripts/install-kubuntu26.04.sh"
  "xubuntu26|xubuntu26.04|scripts/install-xubuntu26.04.sh"
  "mate26|ubuntu-mate26.04|scripts/install-mate26.04.sh"
  "budgie26|ubuntu-budgie26.04|scripts/install-budgie26.04.sh"
  "lubuntu20|lubuntu20.04|scripts/install-lubuntu20.04.sh"
  "lubuntu22|lubuntu22.04|scripts/install-lubuntu22.04.sh"
  "lubuntu24|lubuntu24.04|scripts/install-lubuntu24.04.sh"
  "lubuntu26|lubuntu26.04|scripts/install-lubuntu26.04.sh"
)

# VM gestite dal Makefile ma non coperte da questo flusso e2e.
# Windows richiede una modalità dedicata: non spegne a fine install come Subiquity
# e la verifica guest-agent/comandi non è compatibile con quella Linux.
TEST_EXCLUDED_ITEMS=(
  "ubuntu24|ubuntu24.04|desktop ISO GNOME: contratto e2e non uniforme"
  "ubuntu26|ubuntu26.04|desktop ISO GNOME: contratto e2e non uniforme"
  "debian13|Debian13|preseed/desktop: contratto e2e non uniforme"
  "win10|Windows10|Windows unattended: richiede modalità test Windows"
  "win11|Windows11|Windows unattended: richiede modalità test Windows"
  "win7u|Windows7U|Windows unattended: richiede modalità test Windows"
)
