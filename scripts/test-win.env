# Configurazione del test end-to-end Windows (scripts/test-win.sh)
# Sovrascrivibile da variabili d'ambiente: es. TEST_WIN_PARALLEL=1 bash scripts/test-win.sh
#
# A differenza del test Linux (Subiquity: install -> shut off -> start -> desktop),
# le VM Windows installano in un flusso unico: lo script create_* ritorna subito
# (--noautoconsole) e il setup prosegue nella VM con vari riavvii, SENZA spegnersi
# a fine install. Il QEMU guest agent risponde gia' DURANTE il setup (i tool
# vengono installati prima della fine di OOBE), quindi "desktop pronto" e':
# agent up + marker C:\lab-setup-done.txt + OOBEInProgress=0 + explorer.exe attivo
# (vedi win_desktop_ready in scripts/test-lib.sh).

# Quante VM testare in parallelo. Windows e' pesante (win11 usa 8 GB di RAM):
# default basso.
TEST_WIN_PARALLEL="${TEST_WIN_PARALLEL:-2}"

# Cartella output (report HTML + log + screenshot). Override: TEST_WIN_OUTDIR=/path.
TEST_WIN_OUTDIR="${TEST_WIN_OUTDIR:-${TMPDIR:-/tmp}/vmlab-win-e2e}"

# Apri il report HTML nel browser all'avvio (1=si, 0=no, utile headless).
TEST_OPEN_BROWSER="${TEST_OPEN_BROWSER:-1}"

# Timeout (secondi)
# Avvio VM dopo il lancio dello script create_* (deve risultare "running").
TEST_WIN_BOOT_TIMEOUT="${TEST_WIN_BOOT_TIMEOUT:-300}"
# Install completa -> desktop pronto (boot + setup + OOBE + autologon + tools). Windows e' lento.
TEST_WIN_READY_TIMEOUT="${TEST_WIN_READY_TIMEOUT:-5400}"   # ~90 min
# VM senza canale guest-agent (es. win7u): attesa fissa stimata di fine install
# prima dello screenshot, non potendo interrogare il guest.
TEST_WIN_NOAGENT_WAIT="${TEST_WIN_NOAGENT_WAIT:-2400}"     # ~40 min
# Spegnimento ordinato (ACPI) della VM dopo verifica/screenshot.
TEST_WIN_SHUTDOWN_TIMEOUT="${TEST_WIN_SHUTDOWN_TIMEOUT:-300}"
# Intervallo polling.
TEST_WIN_POLL="${TEST_WIN_POLL:-30}"

# -----------------------------------------------------------------------------
# VM da testare: derivate dal registro vms.tsv (family=windows, e2e=yes), che e'
# l'unica fonte di verita' dell'inventario. La colonna agent del registro decide
# il tipo di verifica.
#
# Formato item: "id|vm|script|agent"
#   agent=yes -> verifica via QEMU guest agent (guest-ping + guest-exec cmd.exe)
#   agent=no  -> nessun canale agent: verifica solo via screenshot (WARN)
# -----------------------------------------------------------------------------
_VMLAB_ENV_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

mapfile -t TEST_WIN_ITEMS < <(bash "$_VMLAB_ENV_DIR/vms-registry.sh" --items windows)
mapfile -t TEST_WIN_EXCLUDED_ITEMS < <(bash "$_VMLAB_ENV_DIR/vms-registry.sh" --excluded windows)

if [ "${#TEST_WIN_ITEMS[@]}" -eq 0 ]; then
    echo "ATTENZIONE: nessuna VM Windows con e2e=yes nel registro vms.tsv" >&2
fi
